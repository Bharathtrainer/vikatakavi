# Copy to .env for local runs. Never commit .env.

# LiveKit Cloud (https://cloud.livekit.io -> your project -> Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Sarvam AI (https://dashboard.sarvam.ai)
SARVAM_API_KEY=
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_TTS_SPEAKER=aditya
DEFAULT_LANGUAGE=te-IN

# Avatar: none = browser-animated portrait (free, default) | runway | selfhosted (phase 2)
AVATAR_PROVIDER=none
RUNWAYML_API_SECRET=
RUNWAY_AVATAR_ID=
MAX_CALL_SECONDS=180

# Eyes: the user's camera, analysed only when VikataKavi looks
VISION_ENABLED=true
SARVAM_VISION_MODEL=gemma4

# Web
AGENT_NAME=vikatakavi
ACCESS_CODE=
